{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['hostUid', 'playback']) && newData.child('hostUid').isString())",
        "hostUid": {
          ".write": "auth != null && data.val() === auth.uid && newData.isString() && root.child('rooms').child($roomId).child('members').child(newData.val()).child('online').val() === true",
          ".validate": "newData.isString()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.hasChild('name')",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "pingAt": {
              ".validate": "newData.isNumber()"
            },
            "pingNonce": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            }
          }
        },
        "playback": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
          ".validate": "!newData.exists() || newData.hasChildren(['videoId', 'title', 'time', 'paused', 'revision', 'updatedAt', 'updatedBy'])",
          "videoId": {
            ".validate": "newData.isString() && newData.val().length === 11"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "paused": {
            ".validate": "newData.isBoolean()"
          },
          "revision": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "auth != null && newData.isString() && newData.val() === auth.uid"
          }
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name', 'text', 'createdAt']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 400 && newData.child('createdAt').isNumber())"
          }
        },
        "reactions": {
          "$reactionId": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'emoji', 'x', 'createdAt']) && newData.child('uid').val() === auth.uid && newData.child('emoji').isString() && newData.child('emoji').val().length <= 12 && newData.child('x').isNumber() && newData.child('x').val() >= 0 && newData.child('x').val() <= 100 && newData.child('createdAt').isNumber())"
          }
        },
        "playlist": {
          "$itemId": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && newData.child('addedBy').val() === auth.uid) || (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid && !newData.exists()))",
            ".validate": "!newData.exists() || newData.hasChildren(['videoId', 'title', 'addedBy', 'addedByName', 'votes', 'createdAt'])",
            "videoId": {
              ".validate": "newData.isString() && newData.val().length === 11"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "addedBy": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "addedByName": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "votes": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "voters": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && root.child('rooms').child($roomId).child('playlist').child($itemId).exists()",
                ".validate": "newData.val() === true"
              }
            }
          }
        },
        "polls": {
          "$pollId": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && newData.child('createdBy').val() === auth.uid) || (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid && !newData.exists()))",
            ".validate": "!newData.exists() || newData.hasChildren(['question', 'options', 'createdBy', 'createdAt', 'active'])",
            "question": {
              ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 160"
            },
            "options": {
              ".validate": "newData.hasChildren(['o1', 'o2'])",
              "$optionId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              }
            },
            "createdBy": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "createdByName": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "active": {
              ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid || root.child('rooms').child($roomId).child('polls').child($pollId).child('createdBy').val() === auth.uid) && data.val() === true && newData.val() === false",
              ".validate": "newData.isBoolean()"
            },
            "votes": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && root.child('rooms').child($roomId).child('polls').child($pollId).child('active').val() === true && (!newData.exists() || root.child('rooms').child($roomId).child('polls').child($pollId).child('options').child(newData.val()).exists())",
                ".validate": "newData.isString()"
              }
            }
          }
        }
      }
    }
  }
}
